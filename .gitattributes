* text=auto eol=lf

*.bat text eol=crlf
*.cmd text eol=crlf

*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.pdf binary
*.pptx binary
*.xlsx binary
*.xls binary
*.zip binary
*.woff binary
*.woff2 binary
*.ttf binary
*.otf binary

*.wasm binary
# Power BI containers are zip archives, and the oracle dumps must keep their
# exact bytes: a CRLF checkout would put a carriage return in every last cell.
*.pbix binary
*.pbit binary
*.tsv -text
# Vendored third-party source stays byte-identical to upstream.
packages/pbi/vendor/** -text
