{
  "name": "@consultchimps/pptx",
  "version": "0.4.0",
  "description": "PowerPoint template inspection and population for ConsultChimps.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/consultchimps/consultchimps.git",
    "directory": "packages/pptx"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean",
    "prepack": "tsup src/index.ts --format esm --dts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@consultchimps/core": "workspace:*",
    "@consultchimps/files": "workspace:*",
    "@consultchimps/xlsx": "workspace:*",
    "jszip": "3.10.1"
  },
  "devDependencies": {
    "typescript": "7.0.2",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "engines": {
    "node": "24.x"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
