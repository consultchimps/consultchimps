{
  "name": "@consultchimps/pdf",
  "version": "0.1.1",
  "description": "PDF page operations for ConsultChimps.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rashoodz/consultchimps.git",
    "directory": "packages/pdf"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean",
    "prepack": "pnpm build",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@consultchimps/core": "workspace:*",
    "@consultchimps/files": "workspace:*",
    "pdf-lib": "1.17.1"
  },
  "engines": {
    "node": "24.x"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
