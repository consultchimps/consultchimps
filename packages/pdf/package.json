{
  "name": "@consultchimps/pdf",
  "version": "0.4.1",
  "description": "PDF page operations for ConsultChimps.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/consultchimps/consultchimps.git",
    "directory": "packages/pdf"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./bytes": {
      "types": "./dist/bytes.d.ts",
      "import": "./dist/bytes.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts src/bytes.ts --format esm --dts --clean",
    "prepack": "tsup src/index.ts src/bytes.ts --format esm --dts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@consultchimps/core": "workspace:*",
    "@consultchimps/files": "workspace:*",
    "pdf-lib": "1.17.1"
  },
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "devDependencies": {
    "typescript": "7.0.2"
  }
}
