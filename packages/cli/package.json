{
  "name": "consultchimps",
  "version": "0.1.0",
  "description": "Composable operations tools for consultants.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rashoodz/chimpcons.git",
    "directory": "packages/cli"
  },
  "type": "module",
  "bin": {
    "consultchimps": "./dist/index.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@consultchimps/core": "workspace:*",
    "@consultchimps/files": "workspace:*",
    "@consultchimps/pdf": "workspace:*",
    "@consultchimps/xlsx": "workspace:*",
    "commander": "14.0.3"
  },
  "engines": {
    "node": ">=24"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
