{
  "name": "@consultchimps/xlsx",
  "version": "0.1.0",
  "description": "Excel workbook adapters, consolidation, and splitting for ConsultChimps.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rashoodz/chimpcons.git",
    "directory": "packages/xlsx"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean",
    "prepack": "pnpm build",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@consultchimps/core": "workspace:*",
    "@consultchimps/files": "workspace:*",
    "@consultchimps/tabular": "workspace:*",
    "jszip": "3.10.1",
    "saxes": "6.0.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "engines": {
    "node": "24.x"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
