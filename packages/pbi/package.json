{
  "name": "@consultchimps/pbi",
  "version": "0.1.0",
  "private": true,
  "description": "Bounded Power BI container reading for ConsultChimps.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/consultchimps/consultchimps.git",
    "directory": "packages/pbi"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean",
    "prepack": "tsup src/index.ts --format esm --dts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@consultchimps/core": "workspace:*"
  },
  "engines": {
    "node": ">=22.14.0"
  },
  "devDependencies": {
    "jszip": "3.10.1",
    "typescript": "7.0.2"
  }
}
