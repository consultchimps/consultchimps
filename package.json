{
  "name": "consultchimps-workspace",
  "version": "0.1.0",
  "private": true,
  "description": "Durable, composable operations tools for consultants.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/consultchimps/consultchimps.git"
  },
  "type": "module",
  "packageManager": "pnpm@11.10.0",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "build": "pnpm -r --if-present build",
    "changeset": "changeset",
    "check": "pnpm format:check && pnpm lint && pnpm build && pnpm typecheck && pnpm test:coverage && pnpm package:check",
    "consultchimps": "node packages/cli/dist/index.js",
    "docs:dev": "pnpm --filter @consultchimps/docs dev",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint --flag unstable_native_nodejs_ts_config . && pnpm -r --if-present lint",
    "package:check": "node scripts/check-packages.ts",
    "release": "changeset publish",
    "test": "pnpm build && vitest run",
    "test:coverage": "vitest run --coverage",
    "test:run": "vitest run",
    "typecheck": "pnpm -r --if-present typecheck",
    "version-packages": "changeset version && pnpm install --lockfile-only"
  },
  "devDependencies": {
    "@changesets/cli": "2.31.1",
    "@eslint/js": "10.0.1",
    "@types/node": "26.1.1",
    "@vitest/coverage-v8": "4.1.10",
    "eslint": "10.8.0",
    "prettier": "3.9.6",
    "tsup": "8.5.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.65.0",
    "vitest": "4.1.10"
  }
}
